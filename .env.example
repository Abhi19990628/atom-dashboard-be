# ==============================================================================
# INSTRUCTIONS FOR DEVELOPERS:
# 1. Copy this file and rename the copy to exactly '.env' (without the quotes).
# 2. Replace the dummy values below with your local development credentials.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

SECRET_KEY=your_local_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Database Configuration
DB_NAME=Atomone_local
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DB_HOST=localhost
DB_PORT=5432

# Local Email Configuration (Optional for testing)
EMAIL_HOST_USER=your_test_email@gmail.com
EMAIL_HOST_PASSWORD=your_test_email_passwords